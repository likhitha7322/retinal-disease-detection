# RetinaVision AI — Runtime Environment Configuration
# Copy this file to .env and fill in your values before starting the server.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# ── Model Bundle ─────────────────────────────────────────────────────────────
RETINA_MODEL_BUNDLE=model_bundle_v2.1.0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/retinavision.db

# ── CORS (Improvement #2) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for Cross-Origin requests.
# Development default: local Vite + Node dev servers.
# Production: set to the exact deployed frontend URL (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Machine-to-Machine API Key (Improvement #3) ──────────────────────────────
# Leave empty to disable API key authentication (development mode).
# Set a long random secret in production to restrict /predict to authorised callers.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
RETINA_API_KEY=

# ── Inference Options ─────────────────────────────────────────────────────────
# CLAHE contrast enhancement before inference (Improvement #4).
# Set to "true" to enable CLAHE preprocessing — improves contrast in dark fundus images.
RETINA_USE_CLAHE=false

# Test-Time Augmentation — 4-view ensemble averaging (Improvement #5).
# Set to "true" to reduce prediction variance (adds ~3× inference time).
RETINA_USE_TTA=false

# ── Hardware ──────────────────────────────────────────────────────────────────
DEVICE=cuda
UPLOAD_DIR=uploads
